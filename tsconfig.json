{
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "declaration": true,
    "declarationDir": "./.local/types/root",
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun", "@types/bun"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["**/node_modules", "**/.output", "**/.tanstack", "tools/**"],
  "references": [
    { "path": "./docs" },
    { "path": "./packages/calendar" },
    { "path": "./packages/compliance" },
    { "path": "./packages/constants" },
    { "path": "./packages/comms" },
    { "path": "./packages/crm" },
    { "path": "./packages/dms" },
    { "path": "./packages/fleet" },
    { "path": "./packages/platform" },
    { "path": "./packages/hr" },
    { "path": "./packages/inventory" },
    { "path": "./packages/organization" },
    { "path": "./packages/reports" },
    { "path": "./packages/management" },
    { "path": "./packages/masters" },
    { "path": "./packages/notes" },
    { "path": "./packages/tasks" },
    { "path": "./packages/workspace" }
  ]
}
