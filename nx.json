{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "parallel": 1,
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/.output"],
      "cache": true
    },
    "check:lint": {
      "dependsOn": ["^check:lint"],
      "cache": true
    },
    "check:types": {
      "dependsOn": ["^check:types", "^build"],
      "cache": true
    }
  },
  "analytics": false
}
