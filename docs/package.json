{
  "name": "docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun run gen:ref && bun run gen:cf-types && vite build",
    "check:lint": "oxlint --fix . ; oxfmt .",
    "check:types": "bun run gen:ref && fumadocs-mdx && tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "vite dev --port 3005",
    "gen:cf-types": "wrangler types",
    "gen:ref": "bun run ../scripts/generate-ref.ts",
    "gen:ref:check": "bun run ../scripts/generate-ref.ts --check",
    "postinstall": "fumadocs-mdx",
    "preview": "nx vite:preview",
    "start": "nx vite:preview"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.95",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/zalando-sans": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.27",
    "ai": "^7.0.92",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "16.11.1",
    "fumadocs-mdx": "15.1.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.11.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "unist-util-visit": "^5.1.0",
    "use-sync-external-store": "^1.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
