{
  "name": "@aspen-os/workspace",
  "version": "0.1.0",
  "files": [
    "./docs",
    "package.json",
    "README.md",
    "./.output"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "default": "./.output/index.js",
      "types": "./.output/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "check:lint": "oxlint --fix . ; oxfmt .",
    "check:types": "tsc -b"
  },
  "dependencies": {
    "@aspen-os/constants": "workspace:*",
    "@aspen-os/platform": "workspace:*",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:"
  },
  "build": {
    "exports": {
      ".": {
        "path": "./src/index.ts",
        "target": "node"
      }
    },
    "files": [
      "./docs",
      "package.json",
      "README.md"
    ]
  }
}
