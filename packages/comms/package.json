{
  "name": "@aspen-os/comms",
  "version": "0.1.0",
  "files": [
    "./docs",
    "package.json",
    "README.md",
    "./src"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "check:lint": "oxlint --fix . ; oxfmt .",
    "check:types": "tsc -b"
  },
  "dependencies": {
    "@aspen-os/constants": "workspace:*",
    "@aspen-os/platform": "workspace:*",
    "@aws-sdk/client-ses": "catalog:",
    "drizzle-orm": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "build": {
    "exports": {
      ".": {
        "path": "./src/index.ts",
        "target": "node"
      }
    },
    "files": [
      "./docs",
      "package.json",
      "README.md"
    ]
  }
}
