{
  "name": "@aspen-os/platform",
  "version": "0.1.0",
  "bin": {
    "aspen": "./.output/cli/index.js"
  },
  "files": [
    "./docs",
    "package.json",
    "README.md",
    "./.output"
  ],
  "type": "module",
  "exports": {
    "./client": {
      "default": "./.output/client/index.js",
      "types": "./.output/client/index.d.ts"
    },
    "./server": {
      "default": "./.output/server/index.js",
      "types": "./.output/server/index.d.ts"
    },
    "./server/db-schemas": {
      "default": "./.output/server/db-schemas.js",
      "types": "./.output/server/db-schemas.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "check:lint": "oxlint --fix . ; oxfmt .",
    "check:types": "tsc -b",
    "gen:auth-schema": "bunx auth generate --config ./src/server/auth/~config.ts --output ./src/server/auth/db-schema.ts",
    "publish": "bun run build && bun publish"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@better-auth/api-key": "^1.6.28",
    "@better-auth/passkey": "^1.6.28",
    "@opentelemetry/api": "^1.9.1",
    "@orpc/server": "^1.15.0",
    "@standard-schema/spec": "catalog:",
    "@standard-schema/utils": "catalog:",
    "better-auth": "^1.6.28",
    "bun": "catalog:",
    "commander": "^13.1.0",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "nanoid": "^5.1.16",
    "pg": "^8.23.0",
    "pg-boss": "^10.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "valibot": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-rds-data": "^3.1110.0",
    "@electric-sql/pglite": "^0.5.5",
    "@libsql/client": "^0.17.4",
    "@neondatabase/serverless": "^1.1.0",
    "@planetscale/database": "^1.20.1",
    "@types/bun": "catalog:",
    "@types/pg": "^8.21.0",
    "@vercel/postgres": "^0.10.0",
    "better-sqlite3": "^13.0.3",
    "mysql2": "^3.23.3",
    "typescript": "catalog:"
  },
  "build": {
    "bin": {
      "aspen": "./src/cli/index.ts"
    },
    "exports": {
      "./client": {
        "path": "./src/client/index.ts",
        "target": "browser"
      },
      "./server": {
        "path": "./src/server/index.ts",
        "target": "node"
      },
      "./server/db-schemas": {
        "path": "./src/server/db-schemas.ts",
        "target": "node"
      }
    },
    "files": [
      "./docs",
      "package.json",
      "README.md"
    ]
  }
}
