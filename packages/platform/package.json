{
  "name": "@aspen-os/platform",
  "version": "0.1.0",
  "bin": {
    "aspen": "./src/cli/index.ts"
  },
  "files": [
    "./docs",
    "package.json",
    "README.md",
    "./src"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./client": "./src/client/index.ts",
    "./server": "./src/server/index.ts",
    "./server/db-schemas": "./src/server/db/schema/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "check:lint": "oxlint --fix . ; oxfmt .",
    "check:types": "tsc -b",
    "gen:auth-schema": "bunx auth generate --config ./src/server/auth/~config.ts --output ./src/server/db/schema/auth.ts",
    "publish": "bun run build && bun publish"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.1126.0",
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "@better-auth/api-key": "^1.7.2",
    "@better-auth/passkey": "^1.7.2",
    "@electric-sql/pglite": "^0.5.8",
    "@libsql/client": "^0.17.4",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@orpc/server": "^1.15.0",
    "@planetscale/database": "^1.20.1",
    "@standard-schema/spec": "^1.1.0",
    "@standard-schema/utils": "^0.3.0",
    "@vercel/postgres": "^0.10.0",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^13.0.3",
    "bun": "catalog:",
    "commander": "^15.0.0",
    "drizzle-orm": "catalog:",
    "mysql2": "^3.24.3",
    "pg-boss": "^12.30.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "valibot": "catalog:",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "build": {
    "bin": {
      "aspen": "./src/cli/index.ts"
    },
    "exports": {
      "./client": {
        "path": "./src/client/index.ts",
        "target": "browser"
      },
      "./server": {
        "path": "./src/server/index.ts",
        "target": "node"
      },
      "./server/db-schemas": {
        "path": "./src/server/db/schema/index.ts",
        "target": "node"
      }
    },
    "files": [
      "./docs",
      "package.json",
      "README.md"
    ]
  }
}
