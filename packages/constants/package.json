{
  "name": "@aspen-os/constants",
  "version": "0.1.0",
  "files": [
    "package.json",
    "./.output"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "default": "./.output/index.js",
      "types": "./.output/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "check:lint": "oxlint --fix . ; oxfmt .",
    "check:types": "tsc -b"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "build": {
    "exports": {
      ".": {
        "path": "./src/index.ts",
        "target": "node"
      }
    },
    "files": [
      "package.json"
    ]
  }
}
