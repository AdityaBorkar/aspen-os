{
  "file_scan_exclusions": [
    "**/.git",
    "**/.coverage",
    "**/.output",
    "**/node_modules",
    "codedb.snapshot",
    "tsconfig.tsbuildinfo"
  ],
  "format_on_save": "on",
  "formatter": {
    "language_server": "oxfmt"
  },
  "language_servers": [
    "!typescript-language-server",
    "!markdownlint",
    "!eslint",
    "!vtsls",
    "!biome",
    "oxlint",
    "oxfmt",
    "typescript-ls"
    // "..."
  ]
}
