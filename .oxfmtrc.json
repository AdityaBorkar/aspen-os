{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "customGroups": [
      { "elementNamePattern": ["https://**", "http://**"], "groupName": "url" },
      {
        "elementNamePattern": [
          "bun:*",
          "bun:*/*",
          "npm:*",
          "npm:*/*",
          "deno:*",
          "deno:*/*",
          "jsr:*",
          "jsr:*/*"
        ],
        "groupName": "protocol"
      }
    ],
    "groups": [
      "url",
      ["builtin", "protocol", "subpath"],
      "external",
      ["internal", "parent", "sibling", "index", "style"],
      "unknown"
    ]
  }
}
